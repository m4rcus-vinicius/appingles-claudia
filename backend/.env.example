# Chave de API do Google AI Studio (Gemini)
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo nativo de áudio com suporte à Multimodal Live API (BidiGenerateContent)
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest

# Voz nativa do Gemini Live (Opções: Puck, Charon, Kore, Fenrir, Aoede)
GEMINI_VOICE_NAME=Puck

# Porta e Host do servidor Gateway
PORT=3001
HOST=0.0.0.0
