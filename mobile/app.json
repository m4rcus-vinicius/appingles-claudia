{
  "expo": {
    "name": "Cláudia - Inglês Sem Filtro",
    "slug": "appingles-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.appingles.tutor",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Precisamos do microfone para praticar conversação em inglês em tempo real com a Cláudia.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.appingles.tutor",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0F19"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir que $(PRODUCT_NAME) acesse seu microfone para conversação em tempo real."
        }
      ],
      "expo-status-bar"
    ]
  }
}
